# ============================================
# Adaptive Trader Risk Intelligence
# Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# PostgreSQL
POSTGRES_USER=trader_risk
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=trader_risk_intel

# Backend
DATABASE_URL=postgresql+asyncpg://trader_risk:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/trader_risk_intel
DATABASE_URL_SYNC=postgresql://trader_risk:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/trader_risk_intel
API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
LOG_LEVEL=INFO
ENGINE_VERSION=1.0.0

# Frontend (build-time)
VITE_API_URL=http://localhost:8000
VITE_API_KEY=CHANGE_ME_TO_MATCH_BACKEND_API_KEY
